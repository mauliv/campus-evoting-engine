# ==============================================================================
# CAMPUSBALLOT CORE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production or staging values.
# ==============================================================================

# Database Connection (PostgreSQL 13+)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=evoting_db
DB_USER=postgres
DB_PASS=your_secure_password_here
DB_SCHEMA=evoting, public

# Centralized SSO (Central Authentication Service / CAS)
CAS_HOST=sso.example.edu
CAS_PORT=443
CAS_CONTEXT=/cas
CAS_SERVER_VALIDATION=false

# System Runtime
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
