{
    "name": "campusevoting/core",
    "description": "High-concurrency federated e-voting platform for university student elections",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alifah Mauliddin Nur Ikhsan",
            "email": "alif.maulidin@gmail.com",
            "role": "Lead Architect & Developer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "apereo/phpcas": "^1.6.1",
        "ext-pgsql": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CampusBallot\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
